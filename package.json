{
  "name": "template-react-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "type-check": "tsc -b",
    "dev": "vite",
    "dev:server": "npm run dev --prefix server",
    "build": "tsc -b && vite build && npm run build:sw",
    "build:sw": "vite build --config vite.sw.config.ts",
    "lint": "eslint . --cache",
    "preview": "vite preview --port 4173",
    "deploy": "gh-pages -d dist",
    "validate": "echo 'Regras invioláveis verificadas pelo TypeScript durante type-check'"
  },
  "dependencies": {
    "lucide-react": "^1.7.0",
    "lz-string": "^1.5.0",
    "motion": "^14.6.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router": "^7.9.5",
    "react-router-dom": "^7.18.4",
    "tempest-react-sdk": "^0.75.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@playwright/test": "^1.62.1",
    "@types/lz-string": "^1.3.34",
    "@types/node": "^24.13.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.4",
    "esbuild": "^0.25.12",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "gh-pages": "^6.3.0",
    "globals": "^16.4.0",
    "prettier": "^3.8.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.45.0",
    "vite": "npm:rolldown-vite@7.1.14"
  },
  "overrides": {
    "vite": "npm:rolldown-vite@7.1.14"
  }
}
